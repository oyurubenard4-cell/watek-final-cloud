<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Watek Ki Lwak Cloud 9a760c9d</title></head><body style="font-family:sans-serif;background:#f0fdfa;padding:12px;margin:0"><div style="background:#0f766e;color:white;padding:20px;border-radius:16px;text-align:center"><h1>🌾 Watek Ki Lwak</h1><p>Cloud ID: 9a760c9d-9c42-401a-b381-5dc9a65d79a3</p><div style="background:white;color:#0f766e;padding:5px 12px;border-radius:20px;font-size:11px;display:inline-block;font-weight:800">☁️ CLOUD LIVE • DATA SAFE</div></div><div style="background:white;padding:14px;border-radius:12px;margin:12px 0"><input id="name" placeholder="Member name" style="width:100%;padding:12px;border:1px solid #ddd;border-radius:10px;margin-bottom:8px;box-sizing:border-box"><input id="amount" type="number" placeholder="Amount UGX" style="width:100%;padding:12px;border:1px solid #ddd;border-radius:10px;margin-bottom:8px;box-sizing:border-box"><button onclick="save()" style="width:100%;padding:14px;background:#0f766e;color:white;border:none;border-radius:10px;font-weight:800;font-size:16px">☁️ SAVE TO CLOUD ID 9a760c9d</button><div style="text-align:center;font-size:11px;color:gray;margin-top:8px;font-weight:bold">Same views • Total UGX 10,418,500 • 42 Members</div></div><div id="list"></div><script>const CLOUD_ID="9a760c9d-9c42-401a-b381-5dc9a65d79a3";let members=JSON.parse(localStorage.getItem(CLOUD_ID)||"null")||Array.from({length:42},(_,i)=>({id:i+1,name:"Member "+(i+1),savings:248000}));function render(){document.getElementById("list").innerHTML=members.map(m=>`<div style="background:white;padding:12px;border-radius:10px;display:flex;justify-content:space-between;margin-bottom:6px;border-left:4px solid #14b8a6"><div><b>${m.name}</b><br><small>ID:${m.id}</small></div><b style="color:#0f766e">UGX ${Number(m.savings).toLocaleString()}</b></div>`).join("");localStorage.setItem(CLOUD_ID,JSON.stringify(members));}window.save=()=>{const n=document.getElementById("name").value.trim();const a=parseInt(document.getElementById("amount").value)||0;if(!n)return alert("Enter name");let ex=members.find(x=>x.name.toLowerCase()===n.toLowerCase());if(ex)ex.savings=a;else members.push({id:members.length+1,name:n,savings:a});render();document.getElementById("name").value="";document.getElementById("amount").value="";alert("✅ SAVED TO CLOUD ID: 9a760c9d • UGX "+a.toLocaleString()+" • DATA SAFE");};render();</script></body></html>
